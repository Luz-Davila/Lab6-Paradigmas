# UNA Chat — variables de entorno
# Copiar a .env y completar con los valores reales. Nunca commitear .env.

# Dominio del tenant de Auth0, sin https:// y sin barra final.
AUTH0_DOMAIN=tu-tenant.us.auth0.com

# Credenciales de la aplicación (Auth0 → Applications → UNA Chat → Settings).
AUTH0_CLIENT_ID=tu-client-id
AUTH0_CLIENT_SECRET=tu-client-secret

# Clave para cifrar la cookie de sesión (64 caracteres hex).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=genera-una-clave-de-64-caracteres-hex

# URL base de la aplicación: local o el dominio de Vercel.
APP_BASE_URL=http://localhost:3000

# Puerto del servidor local (en Vercel lo define la plataforma).
PORT=3000
